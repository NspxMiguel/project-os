# pi-gen configuration for the project-os image.
#
#   "é um os msm, tu flesha direto no balenna, tu acessa o ip no chrome e dale,
#    igual o os do homeassist"
#
# So the deliverable is a .img.xz you write to a card, not a script you run on
# top of Raspberry Pi OS. This builds on pi-gen's stage2 (Lite: no desktop, no
# browser, nothing to plug a monitor into) and adds one stage of our own.
#
# Sourced by pi-gen's build.sh -- shell assignments only.

IMG_NAME=project-os
RELEASE=bookworm

# Lite plus our stage. stage3+ are desktop images; a headless box does not need
# a window manager it will never draw.
STAGE_LIST="stage0 stage1 stage2 ./image/stage-project-os"

# Written to the card with Etcher, so ship it compressed.
DEPLOY_COMPRESSION=xz
COMPRESSION_LEVEL=6
DEPLOY_ZIP=0

# project-os.local is how you find the machine with no monitor attached.
TARGET_HOSTNAME=project-os

# SSH is on: without a screen it is the only way in when something goes wrong.
#
# FIRST_USER_PASS is here because pi-gen wants one, not because it is ever usable:
# our stage locks the account immediately afterwards and clears pi-gen's
# "change your password at next login" flag, which otherwise survives into the
# password the browser sets later and makes sshd hang up on every login. The real
# password is invented on the first-run screen and exists only on that card.
ENABLE_SSH=1
FIRST_USER_NAME=project-os
FIRST_USER_PASS=project-os
DISABLE_FIRST_BOOT_USER_RENAME=1

LOCALE_DEFAULT=en_US.UTF-8
TIMEZONE_DEFAULT=Etc/UTC
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
