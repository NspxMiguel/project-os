#!/bin/bash
# Wi-Fi from a file on the card, read once at every boot.
#
# The Pi has no monitor and, on Wi-Fi, no network either -- so there is no way
# in at all until it joins one. Etcher does not write settings, so the settings
# have to be somewhere you can reach with the card still in the laptop: the boot
# partition, which mounts on any machine.
#
# Drop a file called projectos-wifi.txt next to config.txt:
#
#     ssid=MinhaRede
#     password=minhasenha
#     country=BR
#
# It is read on every boot, not only the first, so a network that changed can be
# fixed by editing the card instead of reflashing it. The file is deleted after a
# successful connection: it holds the Wi-Fi password in clear text, and leaving
# it on a partition every computer can read is not something to do quietly.

set -u

BOOT_DIR=/boot/firmware
[ -d "$BOOT_DIR" ] || BOOT_DIR=/boot
CONF="$BOOT_DIR/projectos-wifi.txt"

log() { logger -t projectos-firstboot "$*"; printf '%s\n' "$*"; }

[ -f "$CONF" ] || exit 0

ssid=""
password=""
country=""
while IFS='=' read -r key value; do
    key=$(printf '%s' "$key" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    value=$(printf '%s' "${value-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')
    case "$key" in
        ssid) ssid="$value" ;;
        password|psk) password="$value" ;;
        country) country="$value" ;;
        ''|\#*) ;;
    esac
done < "$CONF"

if [ -z "$ssid" ]; then
    log "projectos-wifi.txt has no ssid= line; ignoring it"
    exit 0
fi

if [ -n "$country" ]; then
    raspi-config nonint do_wifi_country "$country" >/dev/null 2>&1 || true
fi
rfkill unblock wifi >/dev/null 2>&1 || true

log "joining Wi-Fi network '$ssid'"
if [ -n "$password" ]; then
    nmcli device wifi connect "$ssid" password "$password" >/dev/null 2>&1
else
    nmcli device wifi connect "$ssid" >/dev/null 2>&1
fi

# nmcli returns before the address is up often enough that checking once lies.
for _ in $(seq 1 20); do
    if nmcli -t -f STATE general status 2>/dev/null | grep -q '^connected'; then
        log "connected; removing $CONF (it holds the password in clear text)"
        rm -f "$CONF"
        exit 0
    fi
    sleep 3
done

log "could not join '$ssid' -- leaving $CONF in place so it can be corrected"
exit 0
