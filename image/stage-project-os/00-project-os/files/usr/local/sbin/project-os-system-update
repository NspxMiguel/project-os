#!/bin/sh
# Escreve um sistema inteiro no slot que NÃO está rodando.
#
# É a única coisa no projeto que formata uma partição. O erro que ele precisa
# tornar impossível é um só, e é fatal: formatar o slot que está no ar. Por isso
# a checagem não é "confio em quem me chamou" -- o project-os já confere tudo
# isso antes de chamar, e mesmo assim conferimos de novo aqui, porque este é o
# lado que tem poder de root e o outro não.
#
# Uso:  project-os-system-update <tarball> <slot A|B>
#
# O tarball já chegou conferido pelo sha256 do manifesto (core/updates.py se
# recusa a instalar sem isso). Aqui a preocupação é outra: em qual pedaço de
# disco isto vai parar.

set -eu

TARBALL="${1:-}"
SLOT="${2:-}"
MONTAGEM=/run/project-os-alvo

erro() { echo "project-os-system-update: $*" >&2; exit 1; }

[ -n "$TARBALL" ] && [ -n "$SLOT" ] || erro "uso: project-os-system-update <tarball> <A|B>"
[ -f "$TARBALL" ] || erro "$TARBALL não existe"

case "$SLOT" in
    A) NUMERO=2 ;;
    B) NUMERO=3 ;;
    *) erro "slot inválido: $SLOT" ;;
esac

# De qual disco estamos falando: o mesmo de onde a raiz está montada. Não se
# aceita um caminho de dispositivo de quem chamou -- assim não existe argumento
# capaz de apontar isto para outro disco.
RAIZ=$(findmnt -no SOURCE / 2>/dev/null) || erro "não sei qual é a raiz"
[ -n "$RAIZ" ] || erro "não sei qual é a raiz"
DISCO=$(echo "$RAIZ" | sed -E 's/p?[0-9]+$//')
case "$DISCO" in
    *[0-9]) SEP=p ;;
    *)      SEP=  ;;
esac
ALVO="${DISCO}${SEP}${NUMERO}"

[ -b "$ALVO" ] || erro "$ALVO não existe (este cartão tem dois sistemas?)"

# A trava que importa.
[ "$ALVO" != "$RAIZ" ] || erro "recusando formatar o sistema que está rodando ($ALVO)"
if findmnt -no TARGET "$ALVO" >/dev/null 2>&1; then
    erro "$ALVO está montado; recusando"
fi

echo "formatando $ALVO (slot $SLOT)"
mkfs.ext4 -q -F -L "pos-root$SLOT" "$ALVO"

mkdir -p "$MONTAGEM"
mount "$ALVO" "$MONTAGEM"

limpar() {
    umount "$MONTAGEM" 2>/dev/null || true
    rmdir "$MONTAGEM" 2>/dev/null || true
}
trap limpar EXIT INT TERM

echo "desempacotando o sistema"
# --numeric-owner: os números de uid/gid do tarball valem mais que os nomes
# deste sistema aqui. -p preserva permissão, que é o que faz o sudo continuar
# sendo sudo do outro lado.
tar --numeric-owner -xpf "$TARBALL" -C "$MONTAGEM"

# Um sistema sem estes diretórios não sobe, e tar de rootfs às vezes vem sem
# eles quando foram gerados a partir de um contêiner.
for diretorio in proc sys dev run tmp boot/firmware; do
    mkdir -p "$MONTAGEM/$diretorio"
done
chmod 1777 "$MONTAGEM/tmp"

# O fstab que veio dentro do tarball diz que a raiz é a p2, porque era verdade
# na máquina de onde ele saiu. Aqui ele passa a dizer a verdade deste slot.
# O porquê de não bastar apagar a linha está escrito no fstab-slot.sh.
if [ -f "$MONTAGEM/etc/fstab" ] && [ -x /usr/share/project-os/fstab-slot.sh ]; then
    /usr/share/project-os/fstab-slot.sh \
        "$MONTAGEM/etc/fstab" "$ALVO" "${DISCO}${SEP}1" || \
        echo "aviso: não consegui ajustar o fstab do slot $SLOT" >&2
fi

# O tarball traz um /etc de fábrica, e algumas coisas em /etc são DESTA CAIXA,
# não desta versão. Sem levá-las junto, o slot novo sobe como um aparelho recém-
# desembalado -- e é aí que a promessa toda se desfaz:
#
#   - a senha do Wi-Fi mora em /etc/NetworkManager/system-connections, e só ali:
#     o project-os-firstboot apaga o project-os-wifi.txt da FAT assim que
#     conecta, de propósito, porque é senha em texto puro. Num Pi ligado por
#     Wi-Fi, o slot novo subiria sem rede, o /api/system/health nunca seria
#     chamado, o slot nunca seria confirmado, e três boots depois o initramfs
#     voltaria sozinho. Ou seja: toda atualização por Wi-Fi terminaria em volta
#     atrás, sempre, e a única saída seria o cartão no PC de novo;
#   - a senha que ele criou na tela de primeiro uso mora em /etc/shadow. O
#     tarball traz a conta trancada, como sai de fábrica;
#   - as chaves de host do SSH. Trocadas, o cliente dele recusa a conexão com
#     "REMOTE HOST IDENTIFICATION HAS CHANGED", que numa caixa sem tela parece
#     invasão, e não atualização.
#
# A raiz que está rodando é a origem: quem chama este script está dentro dela.
echo "levando a identidade desta caixa para o slot novo"

preservar() {
    [ -e "/$1" ] || return 0
    mkdir -p "$MONTAGEM/$(dirname "$1")"
    cp -a "/$1" "$MONTAGEM/$(dirname "$1")/" 2>/dev/null || \
        echo "aviso: não consegui levar /$1" >&2
}

for item in etc/NetworkManager/system-connections \
            etc/wpa_supplicant/wpa_supplicant.conf \
            etc/ssh/ssh_host_rsa_key etc/ssh/ssh_host_rsa_key.pub \
            etc/ssh/ssh_host_ecdsa_key etc/ssh/ssh_host_ecdsa_key.pub \
            etc/ssh/ssh_host_ed25519_key etc/ssh/ssh_host_ed25519_key.pub \
            etc/hostname etc/machine-id; do
    preservar "$item"
done

# A senha: só a linha da conta dele. O /etc/shadow inteiro não serve -- o do
# tarball tem as contas de sistema que a versão nova criou.
if [ -f "$MONTAGEM/etc/shadow" ] && grep -q "^project-os:" /etc/shadow 2>/dev/null; then
    LINHA=$(grep "^project-os:" /etc/shadow)
    sed -i "/^project-os:/d" "$MONTAGEM/etc/shadow"
    printf '%s\n' "$LINHA" >> "$MONTAGEM/etc/shadow"
fi

sync
echo "slot $SLOT gravado"
