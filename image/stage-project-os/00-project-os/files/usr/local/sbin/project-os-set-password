#!/bin/sh
# Set the password of the one account this box logs in with.
#
# The web interface runs as an unprivileged user and must stay that way, but a
# Unix password can only be changed by root. So: one root-owned helper that does
# exactly this and nothing else, allowed through sudo with no password, reading
# "user:password" on stdin.
#
# Deliberately narrow:
#   * it accepts one line and ignores the rest;
#   * it refuses any account other than the service one, so a compromised web
#     process cannot rewrite root's password;
#   * the secret arrives on stdin, never as an argument -- arguments are visible
#     in `ps` to every user on the machine.
set -eu

ALLOWED=project-os

read -r line || exit 1
user=${line%%:*}
password=${line#*:}

[ "$user" = "$ALLOWED" ] || { echo "refusing to touch account '$user'" >&2; exit 2; }
[ -n "$password" ] || { echo "empty password" >&2; exit 3; }

printf '%s:%s\n' "$user" "$password" | chpasswd
# The image ships this account locked (no password at all). Setting one has to
# unlock it too, or the login would still be refused.
passwd -u "$user" >/dev/null 2>&1 || true
