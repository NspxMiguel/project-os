[Unit]
Description=project-os
Documentation=https://github.com/NspxMiguel/project-os
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=project-os
Group=project-os
Environment=PROJECT_OS_HOME=/var/lib/project-os
WorkingDirectory=/opt/project-os
ExecStart=/opt/project-os/.venv/bin/python -m project_os --host 0.0.0.0 --port 80

# Port 80 so the address is just the IP -- typing a port number is exactly the
# kind of thing that makes a box feel like a script instead of a system. The
# capability is granted to the process, not root to the user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

Restart=always
RestartSec=3
# It supervises apps of its own; killing only the main process would leave them.
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
